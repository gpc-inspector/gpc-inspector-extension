{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/gpc-on-16.png",
    "32": "icons/gpc-on-32.png",
    "48": "icons/gpc-on-48.png",
    "128": "icons/gpc-on-128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webRequest",
    "webNavigation",
    "tabs",
    "scripting",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/gpc-on-16.png",
      "32": "icons/gpc-on-32.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html?host=panel"
  },
  "minimum_chrome_version": "114",
  "default_locale": "en",
  "web_accessible_resources": [
    {
      "resources": [
        "main-world-assert.js",
        "main-world-insertion.js",
        "main-world-lock.js",
        "main-world-seal.js",
        "main-world-trace-all.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
